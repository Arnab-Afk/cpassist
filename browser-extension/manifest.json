{
  "manifest_version": 3,
  "name": "CPAssist - Coding Progress Tracker",
  "version": "1.0.0",
  "description": "Automatically track your LeetCode, Codeforces, and CodeChef progress with CPAssist",
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://www.codechef.com/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["leetcode-tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://codeforces.com/*"],
      "js": ["codeforces-tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.codechef.com/*"],
      "js": ["codechef-tracker.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"

    }
  },
  "icons": {
    "16": "icons/icon16.png"
  }
}
